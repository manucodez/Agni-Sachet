# ============================================================================
# Agni Sachet — environment configuration
# Copy this file to .env and fill in real values. Never commit .env itself.
# ============================================================================

# ---- App -------------------------------------------------------------------
APP_NAME=agni-sachet
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostGIS) -----------------------------------------------------
# Matches the postgis service in docker-compose.yml.
POSTGRES_USER=agni
POSTGRES_PASSWORD=agni_dev_password
POSTGRES_DB=agni_sachet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL is assembled from the above in app/core/config.py,
# but you can override it directly here if you're pointing at a managed DB.
DATABASE_URL=

# ---- FIRMS (NASA thermal anomaly feed) -------------------------------------
# Get a free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Bounding box for India (west,south,east,north)
FIRMS_BBOX=68.0,6.5,97.5,37.5
# Comma-separated sensors: VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_SENSORS=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_DAY_RANGE=10

# ---- OSM / Overpass ----------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Fallback mirror if the primary instance rate-limits you:
OVERPASS_API_URL_FALLBACK=https://overpass.kumi.systems/api/interpreter

# ---- ESA WorldCover / WorldPop (public, no key needed) ---------------------
WORLDCOVER_S3_BASE=https://esa-worldcover.s3.eu-central-1.amazonaws.com
WORLDPOP_BASE_URL=https://data.worldpop.org

# ---- WRI Global Power Plant Database (public CSV, no key) ------------------
WRI_POWER_PLANTS_URL=https://raw.githubusercontent.com/wri/global-power-plant-database/master/output_database/global_power_plant_database.csv

# ---- VIIRS Nightfire (optional — license-gated, NOT a hard dependency) -----
# Apply at https://payneinstitute.mines.edu/eog/nightfire/ — if this is blank
# or the request fails, the pipeline silently skips VNF confirmation and
# falls back to the ORNL DAAC historical flare survey for training labels.
VNF_LICENSE_KEY=

# ---- ADVANCED: Copernicus Data Space Ecosystem -----------------------------
# One free account covers TROPOMI (Sentinel-5P) and Sentinel-1/2:
# https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- ADVANCED: Google Earth Engine (alternative to CDSE for S1/S2/S5P) ----
# Only needed if USE_GEE_BACKEND=true. Service-account JSON path, not the key
# contents, so it can stay outside the repo entirely.
USE_GEE_BACKEND=false
GEE_SERVICE_ACCOUNT_JSON_PATH=

# ---- ADVANCED: weather / wind (for wind-transport graph edges) ------------
# Open-Meteo needs no key. Set USE_ERA5=true only if you have CDS API access.
USE_ERA5=false
CDS_API_KEY=

# ---- ADVANCED: geospatial foundation model (novelty / open-set detection) --
# Prithvi-EO-2.0 weights are pulled from Hugging Face on first run and cached
# locally — no key needed unless the repo is gated, in which case set a token.
HUGGINGFACE_TOKEN=
GFM_MODEL_ID=ibm-nasa-geospatial/Prithvi-EO-2.0-300M
GFM_DEVICE=cpu                 # cpu | cuda

# ---- Alerts / SACHET -------------------------------------------------------
# Leave blank in dev — alerts just get logged and shown on the dashboard feed.
SACHET_WEBHOOK_URL=

# ---- Sovereign boundary filter (app/ingestion/india_boundary.py) ----------
# On by default. See that module's docstring for why the FIRMS bbox alone
# isn't enough. Only turn this off if you've deliberately repointed
# FIRMS_BBOX at a different country/region.
ENFORCE_INDIA_BOUNDARY=true

# ---- Incident escalation (app/alerts/incident_dispatch.py) -----------------
# Master safety switch — MUST stay false until tier recipients below are
# configured and you've deliberately decided real emails should go out.
# A demo, a replay, or a CI run must never be able to page anyone by
# accident. See app/alerts/email_channel.py's module docstring.
ALERT_DISPATCH_ENABLED=false

# Comma-separated recipient emails per tier. Leave a tier blank to skip it
# (logged as not_configured, not silently treated as sent).
INCIDENT_TIER0_EMAILS=
INCIDENT_TIER0_LABEL=Site Operator / Control Room
INCIDENT_TIER1_EMAILS=
INCIDENT_TIER1_LABEL=Plant Safety Officer
INCIDENT_TIER2_EMAILS=
INCIDENT_TIER2_LABEL=District Disaster Management Authority

# How long an incident sits unacknowledged at one tier before the next
# tier is notified too.
ESCALATION_INTERVAL_SECONDS=900
# A risk_score at or above this notifies every tier immediately instead
# of waiting — see app/alerts/incident_dispatch.py.
INCIDENT_PARALLEL_DISPATCH_RISK_SCORE=90.0

# Used to build the "acknowledge this incident" link in tier emails.
PUBLIC_BASE_URL=http://localhost:8000

# Any SMTP relay works — defaults assume Gmail + an app password (the
# easiest thing to set up during a hackathon with a free account):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
